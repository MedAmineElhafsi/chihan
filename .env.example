# Cîhan — environment variables.
# Copy this file to `.env.local` and fill in real values.
# Never commit real keys. `.env.local` is gitignored.

# --- Supabase (cloud project: https://supabase.com/dashboard) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this server-side only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (test mode) ---
# Dashboard → Developers → API keys (Secret key)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (Products → your Premium product)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=
