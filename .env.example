# Cîhan — environment variables.
# Copy this file to `.env.local` and fill in real values.
# Never commit real keys. `.env.local` is gitignored.

# --- Supabase (cloud project: https://supabase.com/dashboard) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this server-side only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by scripts/run-migration.mjs.
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Contains the database password: keep it in .env.local, never commit it.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Translate button (optional — Google Cloud Translation, Basic/v2) ---
# console.cloud.google.com → APIs & Services → enable "Cloud Translation API"
# → Credentials → Create API key. Restrict the key to that one API.
# The first 500,000 characters a month are free. Without a key the Translate
# button simply does not appear.
GOOGLE_TRANSLATE_API_KEY=

# --- Email invites (optional — Resend) ---
# https://resend.com/api-keys — without this, invites still create a shareable link
RESEND_API_KEY=

# --- Web Push (optional — Settings → Enable notifications) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service
VAPID_SUBJECT=mailto:admin@example.com

# --- Stripe (test mode) ---
# Dashboard → Developers → API keys (Secret key)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (Products → your Premium product)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# --- Business plan (optional — Stripe) ---
# A recurring Price on your Stripe account, e.g. €9.99/month. Without it the
# business plan cannot be bought and every surface for it stays hidden.
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=

# --- Event tickets (optional — Stripe Connect) ---
# Tickets are paid straight into the organiser's own Stripe account, with a
# platform fee (lib/stripe.ts: TICKET_FEE_PERCENT). Enable Connect (Express)
# on your Stripe account first. Set this to "off" to hide ticket selling even
# when Stripe keys exist.
STRIPE_CONNECT=
